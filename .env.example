# Nomor WhatsApp tujuan laporan masalah dari panel Bantuan.
# Format internasional tanpa tanda + dan tanpa spasi, contoh:
#   0822 5889 9903  ->  6282258899903
#
# Di komputer sendiri: salin file ini jadi .env.local lalu isi nomornya.
# Di Vercel: isi lewat Project Settings -> Environment Variables.
#
# Kalau tidak diisi, dipakai nomor yang tercetak di kop kontrabon.
NEXT_PUBLIC_WA_NUMBER=6282258899903
